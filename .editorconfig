# EditorConfig for agent-skills
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = 200
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 2

[*.js]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2
